# Application
# development | test | staging | production
NODE_ENV=development

# Add module-specific environment variables below
# PORT=
# API_BASE_URL=

# proxycheck.io v3 API key（占位，真值走 `wrangler secret put PROXYCHECK_API_KEY`，不入库）
PROXYCHECK_API_KEY=

# Cloudflare Turnstile（占位，仅作用于 /api/risk；secret key 走 `wrangler secret put TURNSTILE_SECRET_KEY`，不入库）
# 前端需要读到 site key，Vite 只暴露 VITE_ 前缀的变量
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
