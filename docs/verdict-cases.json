    },
    {
      "id": "web-full-low-abuse-unknown",
      "applies": [
        "web"
      ],
      "signals": {
        "tzMismatchSystem": false,
        "ipv6Leak": false,
        "riskScore": 10,
        "anonymous": false,
        "abuseListed": null
      },
      "expect": {
        "stage": "full",
        "level": "low"
      },
      "note": "StopForumSpam 不可用时 abuseListed 为未知：未知不贡献信号，也不冒充无收录。O4 仍算已完成——SFS 只贡献中风险，它挂掉不应连累 proxycheck 的结果。"
    },
    {
      "id": "web-full-high-outranks-medium",
      "applies": [
        "web"
      ],
      "signals": {
        "tzMismatchSystem": true,
        "ipv6Leak": true,
        "riskScore": 100,
        "anonymous": false,
        "abuseListed": true
      },
      "expect": {
        "stage": "full",
        "level": "high"
      },
      "note": "高档命中时中档信号不再影响档位。"
    },
