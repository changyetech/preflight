{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "vitest/globals"
    ],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // 判级契约的 golden 向量 docs/verdict-cases.json 由测试直接 import。
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["worker", "tests", "vitest.config.ts"],
  // 渲染测试挂的是前端组件（JSX + DOM 类型），归 tsconfig.app.json 管；
  // 这里保持无 DOM、无 JSX，免得 Worker 代码顺手用上浏览器 API 还能编过。
  "exclude": [
    "tests/render.test.ts",
    "tests/landing.test.ts",
    "tests/footer.test.ts",
    "tests/theme.test.ts",
    "tests/langSwitch.test.ts",
    "tests/a11y.test.ts"
  ]
}
